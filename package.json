{
  "name": "svnc",
  "version": "0.1.0-dev",
  "description": "Simple VNC — browser VNC client with Agent-friendly screenshot and input APIs",
  "type": "module",
  "license": "MIT",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xrdavies/svnc.git"
  },
  "keywords": [
    "vnc",
    "rfb",
    "websocket",
    "remote-desktop",
    "automation",
    "agent"
  ],
  "author": "Frozen's Ami <iy@mail.grokbot.com>",
  "contributors": [
    "xrdavies <1884084+xrdavies@users.noreply.github.com>"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "@novnc/novnc": "^1.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
