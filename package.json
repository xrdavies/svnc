{
  "name": "@xrdavies/svnc",
  "version": "0.2.0",
  "description": "Simple VNC — browser VNC client with Agent-friendly screenshot and input APIs",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xrdavies/svnc.git"
  },
  "keywords": [
    "vnc",
    "rfb",
    "websocket",
    "remote-desktop",
    "automation",
    "agent"
  ],
  "author": "Frozen's Ami <iy@mail.grokbot.com>",
  "contributors": [
    "xrdavies <1884084+xrdavies@users.noreply.github.com>"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e:start": "./scripts/local-e2e/start.sh",
    "e2e:stop": "./scripts/local-e2e/stop.sh",
    "e2e:status": "./scripts/local-e2e/status.sh",
    "e2e:verify": "node scripts/local-e2e/verify-protocol.mjs && node scripts/local-e2e/verify-browser.mjs",
    "demo:serve": "./scripts/local-e2e/serve-demo.sh",
    "e2e:demo": "./scripts/local-e2e/serve-demo.sh",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/jpeg-js": "^0.3.7",
    "@types/node": "^22.10.0",
    "happy-dom": "^20.14.6",
    "puppeteer-core": "^24.43.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "jpeg-js": "^0.4.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
